# ---------------------------------------------------------------------------
# Brand build profile: Sellmo        ->  php build.php sellmo
# See .env.salespay for the block explanation.
# ---------------------------------------------------------------------------

# --- BUILD block (header + readme templating) -------------------------------
PLUGIN_NAME=Sellmo POS Integration
PLUGIN_URI=https://sellmopos.com/
PLUGIN_DESCRIPTION=Integrates WooCommerce with Sellmo POS — product sync, stock sync, and order sync between the two platforms.
VERSION=1.0.1
WP_VERSION=6.0
WP_TESTED_VERSION=6.7
PHP_VERSION=8.0
WC_MIN_VERSION=7.0
WC_TESTED_VERSION=9.0
AUTHOR=Sellmo
AUTHOR_URI=https://sellmopos.com/

# readme.txt "Contributors" — must be WordPress.org account username(s), not a
# display name. Set to your real wp.org login before submitting to the directory.
CONTRIBUTORS=sellmo

# External-service disclosure links shown in readme.txt (required by wp.org
# guidelines 6/7 for the SalesPlay POS backend this plugin talks to).
TERMS_URL=https://sellmopos.com/terms
PRIVACY_URL=https://sellmopos.com/privacy

# SalesPlay REST API base (shared backend for all brands). Baked into the PHP
# at build time via the {{API_BASE}} placeholder.
API_BASE=https://api.backofficewebportal.com/v1.0

# Frozen literals — see .env.salespay.
TEXT_DOMAIN=sellmo-woocommerce
PACKAGE_NAME=Sellmo_WooCommerce

# --- BRAND_ block (shipped verbatim as the package .env) --------------------
BRAND_NAME=Sellmo
BRAND_SLUG=sellmo
BRAND_NAMESPACE=Sellmo
BRAND_TEXT_DOMAIN=pos-integration
BRAND_LOG_PREFIX=Sellmo
BRAND_LOGO=admin/images/sellmo-icon.png
BRAND_WEBSITE=https://sellmopos.com/
BRAND_SUPPORT=sales@sellmopos.com
BRAND_DOCS=https://sellmopos.com/help/
BRAND_EMAIL=sales@sellmopos.com
