# ---------------------------------------------------------------------------
# Brand build profile: SalesPay      ->  php build.php salespay
#
# Two blocks:
#   BUILD block  — fills the {{PLACEHOLDERS}} in the static plugin header and
#                  readme files at build time.
#   BRAND_ block — shipped verbatim as the package's runtime .env, read by
#                  POS_Brand on every request (see includes/class-pos-brand.php).
# Anything not set falls back to a sane default in build.php.
# ---------------------------------------------------------------------------

# --- BUILD block (header + readme templating) -------------------------------
PLUGIN_NAME=SalesPay POS Integration
PLUGIN_URI=https://salesplay.com/
PLUGIN_DESCRIPTION=Integrates WooCommerce with SalesPay POS — product sync, stock sync, and order sync between the two platforms.
VERSION=1.0.1
WP_VERSION=6.0
PHP_VERSION=8.0
WC_MIN_VERSION=7.0
WC_TESTED_VERSION=9.0
AUTHOR=SalesPay
AUTHOR_URI=https://salesplay.com/

# SalesPlay REST API base (shared backend for all brands). Baked into the PHP
# at build time via the {{API_BASE}} placeholder.
API_BASE=https://api.salesplaypos.com/v1.0

# Frozen literals — must match the __() text domain and @package tag baked into
# the PHP. Do NOT rebrand these per build; i18n tooling needs a fixed literal
# (see README "WordPress limitations"). Kept here only so the header agrees.
TEXT_DOMAIN=sellmo-woocommerce
PACKAGE_NAME=Sellmo_WooCommerce

# --- BRAND_ block (shipped verbatim as the package .env) --------------------
BRAND_NAME=SalesPay
BRAND_SLUG=salespay
BRAND_NAMESPACE=SalesPay
BRAND_TEXT_DOMAIN=pos-integration
BRAND_LOG_PREFIX=SalesPay
BRAND_LOGO=admin/images/salespay-icon.png
BRAND_WEBSITE=https://salespay.com
BRAND_SUPPORT=https://salespay.com/support
BRAND_DOCS=https://salespay.com/docs
BRAND_EMAIL=support@salespay.com
