# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# White-label brand configuration.
#
# Copy this file to ".env" in the plugin root and edit the values.
# The plugin reads it once per request (parsed result is cached in memory).
#
# IMPORTANT — two tiers of values live here:
#
#   DISPLAY values  (NAME, WEBSITE, SUPPORT, DOCS, EMAIL, LOG_PREFIX)
#       Safe to change at any time. Takes effect on the next page load.
#
#   IDENTITY values (SLUG, NAMESPACE, TEXT_DOMAIN)
#       Define how data is stored (table names, option keys, meta keys,
#       cron hooks). Changing SLUG on a live site triggers a DATA MIGRATION
#       (see POS_Brand_Migrator). Do NOT change it casually. NAMESPACE and
#       TEXT_DOMAIN are compile-time identifiers and are effectively fixed
#       once shipped — see the README section "WordPress limitations".
# ---------------------------------------------------------------------------

# Visible brand name shown in every UI string. Free text. Change anytime.
BRAND_NAME=SalesPay

# Data-identity slug. Lowercase, [a-z0-9_] only. Drives table/option/cron/meta
# names. Changing this on a live install runs a migration — see README.
BRAND_SLUG=salespay

# Class-name prefix used by NEW code (e.g. logging tags). Compile-time
# identifiers (existing class names) cannot read this — see README.
BRAND_NAMESPACE=SalesPay

# Translation text domain. See README "WordPress limitations": this should be
# a neutral, brand-free literal chosen ONCE and then frozen. Kept here for
# documentation; the code uses a fixed literal for i18n tooling to work.
BRAND_TEXT_DOMAIN=pos-integration

# Log line prefix, e.g. "[SalesPay] Sync started". Change anytime.
BRAND_LOG_PREFIX=SalesPay

# Admin menu logo. Path is relative to the plugin root, or a full URL / data URI.
# Falls back to the WordPress dashicon "store" if unset. Change anytime.
#   Sellmo   -> admin/images/sellmo-icon.png
#   SalesPay -> admin/images/salespay-icon.png
BRAND_LOGO=admin/images/salespay-icon.png

# Public URLs / contact. Change anytime.
BRAND_WEBSITE=https://salespay.com
BRAND_SUPPORT=https://salespay.com/support
BRAND_DOCS=https://salespay.com/docs
BRAND_EMAIL=support@salespay.com
